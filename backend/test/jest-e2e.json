{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "rootDir": "..",
  "roots": ["<rootDir>/test"],
  "testMatch": ["**/*.e2e-spec.ts"],
  "moduleFileExtensions": ["ts", "js", "json"],
  "setupFiles": ["dotenv/config"],
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
  },
  "moduleNameMapper": {
    "^@src/(.*)$": "<rootDir>/src/$1",
    "^(.+)\\.js$": "$1"
  }
}

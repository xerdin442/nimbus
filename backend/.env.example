# ── Node ─────────────────────────────────────────────
NODE_ENV=your-node-env
PORT=your-port

# ── Database ─────────────────────────────────────────
# The API connects as nimbus_app: a non-owner role without BYPASSRLS, so RLS always applies.
DATABASE_URL=postgresql://nimbus_app:your-app-db-password@localhost:5433/nimbus
# Migrations run as the owner role (creates tables, policies, grants).
MIGRATION_DATABASE_URL=postgresql://your-postgres-user:your-postgres-password@localhost:5433/nimbus
NIMBUS_POSTGRES_USER=your-postgres-user
NIMBUS_POSTGRES_PASSWORD=your-postgres-password
NIMBUS_POSTGRES_DB=nimbus
NIMBUS_APP_DB_PASSWORD=your-app-db-password

# ── Test database (e2e: RLS isolation suite) ─────────
TEST_DATABASE_URL=postgresql://nimbus_app:your-app-db-password@localhost:5433/nimbus_test
TEST_MIGRATION_DATABASE_URL=postgresql://your-postgres-user:your-postgres-password@localhost:5433/nimbus_test

# ── Redis ────────────────────────────────────────────
REDIS_PASSWORD=your-redis-password
REDIS_URL=redis://:your-redis-password@localhost:6380

# ── Rate Limiting ────────────────────────────────────
RATE_LIMITING_PER_SECOND=your-rate-limiting-per-second
RATE_LIMITING_PER_MINUTE=your-rate-limiting-per-minute

# ── Dashboard ────────────────────────────────────────
DASHBOARD_URL=your-dashboard-url
